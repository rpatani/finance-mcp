# finance-mcp environment (copy to .env; free crypto/FX tools need no secrets)

MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp
MCP_KEYS_FILE=keys.example.json

MCP_METRICS_BACKEND=prometheus
MCP_METRICS_PORT=9464
LOG_LEVEL=info

MCP_UPSTREAM_TIMEOUT_S=4.0
MCP_UPSTREAM_RETRIES=2
MCP_BREAKER_THRESHOLD=5
MCP_BREAKER_COOLDOWN_S=30

# Required ONLY for the premium tools (get_stock_quote, get_company_overview)
# Free key: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=your-key-here
